{
  "name": "@adaptive-js/jsx",
  "version": "0.0.1",
  "description": "JSX runtime and TSX typing surface for AdaptiveJS.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
