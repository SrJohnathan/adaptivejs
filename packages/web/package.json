{
  "name": "@adaptive-js/web",
  "version": "0.0.1",
  "description": "Web runtime, hydration and reactivity for AdaptiveJS applications.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adaptive-js/core": "0.0.1",
    "@adaptive-js/jsx": "0.0.1",
    "@adaptive-js/shared": "0.0.1"
  }
}
